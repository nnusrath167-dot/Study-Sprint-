# Copy this file to .env and fill these values from Supabase Project Settings → API.
# The anon/publishable key is browser-visible by design; protect data with the RLS policies in supabase/schema.sql.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
PORT=3000
